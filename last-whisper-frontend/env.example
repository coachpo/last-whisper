# Backend URL for Vite dev proxy (server-side only, not exposed to browser)
BACKEND_URL=http://localhost:8000

# Metadata expectations
VITE_EXPECTED_METADATA_SCHEMA_VERSION=2025-11-22

# Development
NODE_ENV=development

# Debug Logging Control
# Set to 'true' to enable debug logging, 'false' to disable
# In development, debug logging is enabled by default
# In production, debug logging is disabled unless explicitly enabled
VITE_DEBUG_LOGGING=false
