{
  "name": "last-whisper-frontend",
  "version": "1.0.0",
  "description": "Last Whisper monorepo frontend application",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/coachpo/last-whisper.git",
    "directory": "last-whisper-frontend"
  },
  "type": "module",
  "scripts": {
